{
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogVersion",
    "locale",
    "status",
    "demoOnly",
    "contentManagement",
    "exercises",
    "routines",
    "mediaAssets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "demoOnly": {
      "type": "boolean"
    },
    "contentManagement": {
      "type": "object",
      "required": [
        "source",
        "futureBackend",
        "syncEnabled"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "futureBackend": {
          "type": "string",
          "minLength": 1
        },
        "syncEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "locale",
          "title",
          "defaultDurationSeconds",
          "position",
          "intensity",
          "tags",
          "reviewStatus",
          "demoOnly",
          "safetyNotes",
          "steps",
          "posterMediaId",
          "mediaAssetIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{2,}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "defaultDurationSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "position": {
            "enum": [
              "seated",
              "standing",
              "mixed"
            ]
          },
          "intensity": {
            "enum": [
              "gentle",
              "easy",
              "moderate"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "demoOnly": {
            "type": "boolean"
          },
          "safetyNotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "order",
                "instruction",
                "framePath"
              ],
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1
                },
                "framePath": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "posterMediaId": {
            "type": "string",
            "minLength": 1
          },
          "mediaAssetIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "routines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "locale",
          "title",
          "description",
          "tags",
          "reviewStatus",
          "demoOnly",
          "totalDurationSeconds",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{2,}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "demoOnly": {
            "type": "boolean"
          },
          "totalDurationSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "order",
                "exerciseId",
                "exerciseVersion",
                "durationSeconds",
                "mediaVariant"
              ],
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "exerciseId": {
                  "type": "string",
                  "minLength": 1
                },
                "exerciseVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "durationSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "mediaVariant": {
                  "enum": [
                    "storyboard",
                    "video",
                    "rive"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "mediaAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "kind",
          "locale",
          "files",
          "reviewStatus",
          "demoOnly",
          "aiGenerated",
          "rights",
          "accessibilityDescription"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "storyboard",
              "video",
              "rive",
              "audio",
              "poster"
            ]
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "demoOnly": {
            "type": "boolean"
          },
          "aiGenerated": {
            "type": "boolean"
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "accessibilityDescription": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An Nhien content catalog schema v1"
}
